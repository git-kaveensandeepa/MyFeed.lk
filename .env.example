# GEMINI_API_KEY: Required for Gemini AI API calls
# AI Studio automatically injects this at runtime from workspace secrets.
GEMINI_API_KEY=
SITE_URL=https://myfeedlk.com
# CRON_SECRET: Optional secret token to secure external cron webhook requests (e.g. GitHub Actions)
CRON_SECRET=
# APP_URL: Production or Cloud Run URL for external webhook triggers
APP_URL=https://myfeedlk.com
