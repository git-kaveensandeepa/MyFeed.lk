rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null 
         && request.auth.token.email == 'mail.kaveensandeepa@gmail.com';
    }

    match /ads/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /articles/{document} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
      
      match /comments/{commentId} {
        allow read: if true;
        allow create, update, delete: if true; // Keeping open or need to lock? Let's leave as true for now or restrict to auth
      }
    }

    match /drafts/{document} {
      allow read, write: if isAdmin();
    }

    match /audio_pipeline_drafts/{document} {
      allow read, write: if isAdmin();
    }

    match /audio_editions/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /system_config/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /autopilot_logs/{document} {
      allow read, write: if isAdmin();
    }
    
    match /analytics/{document} {
      allow create, update: if true;
      allow read: if isAdmin();
    }
    
    match /subscribers/{document} {
      allow create: if request.resource.data.email is string 
                     && request.resource.data.email.size() <= 200 
                     && request.resource.data.email.size() >= 3;
      allow read, update, delete: if isAdmin();
    }

    match /notifications/{document} {
      allow read, write: if isAdmin();
    }

    match /settings/{document} {
      allow read, write: if isAdmin();
    }

    match /web_push_subscriptions/{document} {
      allow read, write: if true;
    }

    match /bytes/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /quizzes/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /store_items/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{document} {
      allow read: if true;
      allow create, update: if request.auth != null && (request.auth.uid == document || isAdmin());
      allow delete: if request.auth != null && (request.auth.uid == document || isAdmin());
    }

    match /account_deletion_requests/{document} {
      allow create: if request.resource.data.email is string
                     && request.resource.data.email.size() <= 200
                     && request.resource.data.email.size() >= 3;
      allow read, update, delete: if isAdmin();
    }
  }
}
