rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null 
        && request.auth.token.email == 'mail.kaveensandeepa@gmail.com';
    }

    // Anyone can read articles, only admins can full write, users can update reactions
    match /articles/{document} {
      allow read: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) || isAdmin();
      allow create, delete: if isAdmin();
    }
    
    match /subscribers/{document} {
      // Anyone can create a subscription with a valid email
      allow create: if request.resource.data.email is string 
                    && request.resource.data.email.size() <= 200 
                    && request.resource.data.email.size() >= 3;
      allow read, update, delete: if isAdmin();
    }

    match /notifications/{document} {
      allow read, write: if isAdmin();
    }

    match /settings/{document} {
      allow read, write: if isAdmin();
    }

    match /users/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == document;
    }
  }
}
