rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null 
        && request.auth.token.email == 'mail.kaveensandeepa@gmail.com' 
        && request.auth.token.email_verified == true;
    }

    // Anyone can read and manage articles
    match /articles/{document} {
      allow read: if true;
      allow create, update, delete: if true;
    }
    
    match /subscribers/{document} {
      allow create: if request.resource.data.email is string 
                    && request.resource.data.email.size() <= 200 
                    && request.resource.data.email.size() >= 3;
      allow read, update, delete: if isAdmin();
    }

    match /notifications/{document} {
      allow read, write: if isAdmin();
    }

    match /settings/{document} {
      allow read, write: if isAdmin();
    }

    match /users/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == document;
    }
  }
}
