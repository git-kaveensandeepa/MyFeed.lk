{
  "collections": [
    {
      "collectionName": "articles",
      "description": "Articles published on the news blog.",
      "fields": [
        { "name": "title", "type": "string", "description": "Title of the article." },
        { "name": "summary", "type": "string", "description": "Short summary of the article." },
        { "name": "content", "type": "string", "description": "Full content of the article." },
        { "name": "imageUrl", "type": "string", "description": "Cover image URL." },
        { "name": "category", "type": "string", "description": "Article category (e.g., AI, Tech, Local)." },
        { "name": "date", "type": "string", "description": "Date formatted string." },
        { "name": "readTime", "type": "string", "description": "Read time estimation." },
        { "name": "createdAt", "type": "timestamp", "description": "Creation timestamp." },
        { "name": "authorId", "type": "string", "description": "ID of the author who created the article." },
        { "name": "featured", "type": "boolean", "description": "Whether this is the featured article." },
        { "name": "reactions", "type": "map", "description": "Emoji reaction counts." }
      ]
    },
    {
      "collectionName": "users",
      "description": "Registered users (admins).",
      "fields": [
        { "name": "email", "type": "string", "description": "User email." },
        { "name": "role", "type": "string", "description": "User role, e.g., 'admin'." }
      ]
    },
    {
      "collectionName": "subscribers",
      "description": "Newsletter subscribers.",
      "fields": [
        { "name": "email", "type": "string", "description": "Subscriber email." },
        { "name": "createdAt", "type": "timestamp", "description": "Subscription timestamp." },
        { "name": "active", "type": "boolean", "description": "Subscription status." }
      ]
    }
  ]
}
