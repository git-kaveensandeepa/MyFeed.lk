{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile containing authentication details, full name, birthday, and role.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "birthday": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "reader", "editor"] },
        "photoURL": { "type": "string" },
        "bio": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "displayName"]
    },
    "Article": {
      "title": "Article",
      "description": "Articles published on the news blog.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "content": { "type": "string" },
        "imageUrl": { "type": "string" },
        "category": { "type": "string" },
        "date": { "type": "string" },
        "readTime": { "type": "string" },
        "authorId": { "type": "string" },
        "featured": { "type": "boolean" }
      },
      "required": ["title", "content", "category"]
    },
    "Subscriber": {
      "title": "Subscriber",
      "description": "Newsletter subscriber record.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "active": { "type": "boolean" }
      },
      "required": ["email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles containing name, email, birthday, and preferences."
    },
    "/articles/{articleId}": {
      "schema": "Article",
      "description": "News articles published on MyFeed.lk."
    },
    "/subscribers/{subscriberId}": {
      "schema": "Subscriber",
      "description": "Newsletter subscribers."
    }
  }
}
